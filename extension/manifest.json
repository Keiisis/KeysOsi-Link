{
    "manifest_version": 3,
    "name": "KeysOsi-Link — AI Meta-Agent Bridge",
    "version": "4.0.0",
    "description": "Meta-Agent bridge: inject files, control AI drones, run autonomous Hive loops across Claude, ChatGPT, Gemini, Arena & Copilot.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "contextMenus",
        "proxy",
        "notifications",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "http://localhost:3666/*",
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "KeysOsi-Link — Ultimate AI Bridge"
    }
}